# Shared environment
# Use development for local work, test for automated tests, production for deployments.
APP_ENV=development
APP_VERSION=0.1.0

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=false
DOCS_ENABLED=true
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_news_credibility
LOG_LEVEL=INFO

# Input and file safety
MAX_ARTICLE_TITLE_CHARS=1000
MAX_ARTICLE_CONTENT_CHARS=20000
MAX_COMBINED_ARTICLE_CHARS=24000
MAX_DATASET_FILE_BYTES=52428800

# Local single-process safeguards
TRAINING_CONCURRENCY_LIMIT=1
EXPLANATION_CONCURRENCY_LIMIT=1
RATE_LIMIT_WINDOW_SECONDS=60
PREDICTION_RATE_LIMIT=120
EXPLANATION_RATE_LIMIT=30
TRAINING_RATE_LIMIT=10
MUTATION_RATE_LIMIT=60
MONITORING_RATE_LIMIT=60
TRUSTED_PROXY_HEADERS=false

# Human review and reviewed-production metrics
REVIEW_NOTE_MAX_CHARS=1000
REVIEW_EVIDENCE_NOTE_MAX_CHARS=2000
PERFORMANCE_MIN_REVIEWED_SAMPLES=20
CALIBRATION_DEFAULT_BINS=10
HIGH_CONFIDENCE_ERROR_THRESHOLD=0.90

# Manual claim and evidence review workspace
CLAIM_TEXT_MIN_CHARS=10
CLAIM_TEXT_MAX_CHARS=1000
CLAIM_NOTE_MAX_CHARS=1000
EVIDENCE_URL_MAX_CHARS=2048
EVIDENCE_TITLE_MAX_CHARS=500
EVIDENCE_PUBLISHER_MAX_CHARS=255
EVIDENCE_EXCERPT_MAX_CHARS=2000
EVIDENCE_NOTE_MAX_CHARS=1000

# Production notes:
# APP_ENV=production
# DEBUG=false
# DOCS_ENABLED=false
# BACKEND_CORS_ORIGINS=https://your-frontend.example
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/database

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
