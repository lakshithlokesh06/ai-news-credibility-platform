APP_NAME="AI News Credibility API"
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_news_credibility
LOG_LEVEL=INFO

MAX_ARTICLE_TITLE_CHARS=1000
MAX_ARTICLE_CONTENT_CHARS=20000
MAX_COMBINED_ARTICLE_CHARS=24000
MAX_DATASET_FILE_BYTES=52428800

TRAINING_CONCURRENCY_LIMIT=1
EXPLANATION_CONCURRENCY_LIMIT=1
RATE_LIMIT_WINDOW_SECONDS=60
PREDICTION_RATE_LIMIT=120
EXPLANATION_RATE_LIMIT=30
TRAINING_RATE_LIMIT=10
MUTATION_RATE_LIMIT=60
MONITORING_RATE_LIMIT=60
TRUSTED_PROXY_HEADERS=false

# Production example:
# APP_ENV=production
# DEBUG=false
# DOCS_ENABLED=false
# BACKEND_CORS_ORIGINS=https://your-frontend.example
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
